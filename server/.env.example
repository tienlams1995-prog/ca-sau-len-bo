# =====================================================================
#  FILE MẪU BIẾN MÔI TRƯỜNG
#  Bước 1: copy file này thành ".env" (cùng thư mục server/)
#  Bước 2: sửa các giá trị bên dưới cho đúng máy của bạn
#  File .env KHÔNG được đưa lên GitHub (đã có trong .gitignore)
#  vì chứa mật khẩu database và khóa bí mật.
# =====================================================================

# Cổng server chạy. Front-end (Vite) sẽ chuyển tiếp /api tới cổng này.
PORT=4000

# Chuỗi kết nối PostgreSQL: postgres://TÊN_USER:MẬT_KHẨU@MÁY:CỔNG/TÊN_DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/casau

# Khóa bí mật để ký JWT (token đăng nhập). Đặt một chuỗi dài, ngẫu nhiên.
JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-bi-mat-dai

# Địa chỉ front-end được phép gọi API (CORS).
CORS_ORIGIN=http://localhost:5173
